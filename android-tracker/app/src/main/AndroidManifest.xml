<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB host is required to talk to the capture dongle over OTG. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:label="Kestrel Tracker"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- fullSensor, NOT unspecified and NOT "landscape".
             The preview rotation is (SENSOR_ORIENTATION - displayRotation). That
             formula only yields a frame whose ASPECT matches the window when the
             window orientation follows the DEVICE. Two ways that breaks:
               - "landscape" (what this used to be) pins the window while the phone
                 is held portrait;
               - omitting screenOrientation pins the window to the natural
                 orientation whenever the user has system auto-rotate switched OFF.
             Either way an upright 4:3 frame renders as a 3:4 strip. Measured from a
             real screenshot: 668x891 inside a 2245x891 window — 30% of the screen,
             exactly what rot=270 predicts. fullSensor makes the window follow the
             physical device regardless of the auto-rotate setting, so window and
             frame aspect agree and the feed fills the screen either way up.
             configChanges keeps the activity (and the camera session) alive across
             rotation instead of tearing it down and restarting the stream. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launch / focus the app when the capture dongle is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
