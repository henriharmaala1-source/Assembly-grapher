<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB host is required to talk to the capture dongle over OTG. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:label="Kestrel Tracker"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- PORTRAIT ONLY. The rig is used one way up, so pin the window there and
             the whole class of orientation bugs goes away with it: the display
             rotation is then always 0 (natural), so the preview rotation reduces to
             the constant SENSOR_ORIENTATION and can no longer disagree with the
             window shape. Every failure so far came from that disagreement — a
             window that did not follow the device ("landscape", or no
             screenOrientation at all while system auto-rotate is OFF) turned an
             upright frame into a 30%-of-screen strip.
             A 16:9 stream rotated upright fills ~85% of a portrait window, against
             64% for 4:3 — so portrait does not cost field of view here, it gains it.
             configChanges stays: it costs nothing and keeps the camera session alive
             if the window is ever resized (split screen, foldable). -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launch / focus the app when the capture dongle is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
